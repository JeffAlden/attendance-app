<service>
  <id>AttendanceApp</id>
  <name>Attendance App</name>
  <description>Time and attendance web app (turnstile + ZKTeco readers)</description>
  <executable>java</executable>
  <arguments>-Dattendance.data-dir=C:/ProgramData/AttendanceApp -jar "%BASE%\attendance-app.jar"</arguments>
  <log mode="roll"></log>
  <onfailure action="restart" delay="10 sec"/>
</service>
